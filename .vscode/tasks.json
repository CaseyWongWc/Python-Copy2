{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "run_notebook_main",
            "type": "shell",
            "command": "bash",
            "args": [
                "-lc",
                "\"${workspaceFolder}/.vscode/python-goog-runner\" \"${workspaceFolder}/sandbox/notebook/main.py\""
            ],
            "group": "test",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "push_replit",
            "type": "shell",
            "command": "bash",
            "args": [
                "${workspaceFolder}/push_replit.sh"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "verify",
            "type": "shell",
            "command": "mvn -B verify",
            "group": "build"
        },
        {
            "label": "test",
            "type": "shell",
            "command": "mvn -B test",
            "group": "test"
        }
    ]
}