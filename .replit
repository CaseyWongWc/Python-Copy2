entrypoint = "main.py"
modules = ["python-3.11"]

[nix]
channel = "stable-25_05"

[unitTest]
language = "python3"

[gitHubImport]
requiredFiles = [".replit", "replit.nix"]

[deployment]
run = ["python3", "main.py"]
deploymentTarget = "cloudrun"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python sandbox/notebook/main.py"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "push"
mode = "sequential"
author = 27304601

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "push_replit.sh"

[[workflows.workflow]]
name = "pull"
mode = "sequential"
author = 27304601

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "git pull"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash push_replit.sh"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 10000
